#!/bin/sh /etc/rc.common
START=95
USE_PROCD=1
start_service() {
  procd_open_instance
  procd_set_param command /usr/bin/lua /usr/share/modgui-luci-wireless/qtn-worker.lua
  procd_set_param respawn 3600 5 5
  procd_close_instance
}
reload_service() {
  /usr/bin/lua /usr/share/modgui-luci-wireless/qtn-worker.lua once
}
