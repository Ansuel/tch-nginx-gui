config openvpn 'server'
	option enabled '0'
	option port '1194'
	option proto 'udp'
	option dev 'tun'
	option ca '/etc/openvpn/ca.crt'
	option cert '/etc/openvpn/server.crt'
	option key '/etc/openvpn/server.key'
	option dh '/etc/openvpn/dh2048.pem'
	option server '10.8.0.0 255.255.255.0'
	option duplicate_cn '1'
	option allow_lan '0'
	option keepalive '10 120'
	option cipher 'AES-256-CBC'
	option auth 'SHA256'
	option persist_key '1'
	option persist_tun '1'
	option user 'root'
	option status '/tmp/openvpn-status.log'
	option verb '3'
	option script_security '3'
	option username_as_common_name '1'
	option auth_user_pass_verify '/etc/openvpn/checkpwd.sh via-env'

config openvpn 'client'
	option enabled '0'
	option config '/etc/openvpn/modgui-client.conf'
	option remote_host ''
	option remote_port '1194'
	option remote_proto 'udp'
	option client_cipher 'AES-256-CBC'
	option client_auth 'SHA256'
	option username ''
