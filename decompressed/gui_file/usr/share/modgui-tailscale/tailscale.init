#!/bin/sh /etc/rc.common

START=95
STOP=10
USE_PROCD=1

start_service() {
	local enabled
	enabled="$(uci -q get tailscale.service.enabled)"
	[ "$enabled" = "1" ] || return 0

	# Runtime provisioning can take longer than Transformer's 30 second
	# commit/apply limit. Keep it entirely inside procd so saving the modal
	# returns immediately, even after a reboot when /tmp is empty.
	procd_open_instance daemon
	procd_set_param command /usr/share/modgui-tailscale/tailscale.bootstrap
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance

	# This one-shot worker waits for the daemon and creates the authorization
	# URL without holding the Transformer apply process open.
	procd_open_instance connect
	procd_set_param command /usr/share/modgui-tailscale/tailscale.connect
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

stop_service() {
	[ -x /usr/sbin/tailscaled ] && /usr/sbin/tailscaled --cleanup >/dev/null 2>&1
	rm -f /tmp/modgui-tailscale-runtime-status /tmp/modgui-tailscale-connect-status
}
