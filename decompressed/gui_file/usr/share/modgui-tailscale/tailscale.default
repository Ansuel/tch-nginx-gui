config service 'service'
	option enabled '0'
	option connect '0'
	option port '41641'
	option hostname 'technicolor'
	option advertise_routes ''
	option advertise_exit_node '0'
	option accept_routes '0'
	option accept_dns '0'
	option ssh '0'
	option funnel_enabled '0'
	option funnel_port '443'
	option funnel_target_port '8080'
	option funnel_target_ip '127.0.0.1'
	option funnel_ssh_enabled '0'
	option funnel_ssh_port '10000'
	option funnel_ssh_target_ip '127.0.0.1'
	option funnel_ssh_target_port '22'
	option funnel_ssh_password_auth '0'
	option runtime_dir '/opt/tailscale'
	option storage_dir '/opt/tailscale'
	option archive_path ''
	option download_url ''
	option archive_sha256 ''
	option state_dir '/opt/modgui-tailscale-state'
