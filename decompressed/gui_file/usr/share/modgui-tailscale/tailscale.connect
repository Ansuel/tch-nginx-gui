#!/bin/sh

# Separate procd instances share this script for connection and Funnel work.
valid_funnel_target() {
	MODGUI_FUNNEL_IP="$1" lua -e 'local i=require("tch.inet"); local ip=os.getenv("MODGUI_FUNNEL_IP"); os.exit((i.isValidIPv4(ip) or i.isValidIPv6(ip)) and 0 or 1)' || return 1
	case "$2" in '' | *[!0-9]*) return 1 ;; esac
	[ "$2" -ge 1 ] && [ "$2" -le 65535 ]
}

run_funnel() {

# Run outside Transformer: enabling Funnel may require approval in a browser.
status_file=/tmp/modgui-tailscale-funnel-status
output_file=/tmp/modgui-tailscale-funnel-output
enabled_option=funnel_enabled
port_option=funnel_port
mode=https
legacy_mode=https
state_dir="$(uci -q get tailscale.service.state_dir)"
[ -n "$state_dir" ] || state_dir=/opt/modgui-tailscale-state
owned_port_file="$state_dir/.modgui-funnel-port"
case "$1" in
ssh | ssh-stop)
	status_file=/tmp/modgui-tailscale-funnel-ssh-status
	output_file=/tmp/modgui-tailscale-funnel-ssh-output
	owned_port_file="$state_dir/.modgui-funnel-ssh-port"
	enabled_option=funnel_ssh_enabled
	port_option=funnel_ssh_port
	mode=tls-terminated-tcp
	legacy_mode=tls-terminated-tcp
	;;
esac
public_url=""
approval_url=""

set_status() {
	printf 'state=%s\nmessage=%s\nurl=%s\napproval_url=%s\n' \
		"$1" "$2" "$public_url" "$approval_url" > "$status_file.$$"
	chmod 644 "$status_file.$$"
	mv -f "$status_file.$$" "$status_file"
}

stop_owned() {
	[ -r "$owned_port_file" ] || return 0
	old_port="$(cat "$owned_port_file")"
	old_mode="$legacy_mode"
	[ ! -r "$owned_port_file.mode" ] || old_mode="$(cat "$owned_port_file.mode")"
	case "$old_mode" in https | tls-terminated-tcp) ;; *) return 1 ;; esac
	case "$old_port" in 443 | 8443 | 10000) ;; *) return 1 ;; esac
	# Preserve the marker until the daemon is available for cleanup.
	[ -S /var/run/tailscale/tailscaled.sock ] || return 0
	# Even "off" requests tailnet approval when Funnel has never been enabled.
	# An unsuccessful authorization attempt has no listener to remove.
	saved_config="$(timeout 10 /usr/sbin/tailscale funnel status --json)" || return 1
	saved_listener="$(jsonfilter -s "$saved_config" -e "@.TCP['$old_port']" 2>/dev/null)"
	if [ -n "$saved_listener" ]; then
		timeout 15 /usr/sbin/tailscale funnel --yes "--$old_mode=$old_port" off > "$output_file" 2>&1 || return 1
	fi
	rm -f "$owned_port_file" "$owned_port_file.mode"
}

umask 077
if [ "$1" = stop ] || [ "$1" = ssh-stop ]; then
	stop_owned || { set_status error "Cannot disable Funnel"; exit 1; }
	set_status disabled "Funnel disabled"
	exit 0
fi

if [ "$(uci -q get "tailscale.service.$enabled_option")" != 1 ] ||
	[ "$(uci -q get tailscale.service.connect)" != 1 ]; then
	# At boot the saved background configuration becomes live with the daemon.
	# Wait for its socket before removing a previously managed public listener.
	attempt=0
	while [ -r "$owned_port_file" ] && [ ! -S /var/run/tailscale/tailscaled.sock ] &&
		[ "$(uci -q get tailscale.service.enabled)" = 1 ] && [ "$attempt" -lt 180 ]; do
		attempt=$((attempt + 1))
		sleep 1
	done
	if [ -r "$owned_port_file" ] && [ ! -S /var/run/tailscale/tailscaled.sock ]; then
		set_status error "Cannot disable Funnel until Tailscale is available"
		exit 1
	fi
	stop_owned || { set_status error "Cannot disable Funnel"; exit 1; }
	set_status disabled "Funnel disabled"
	exit 0
fi

port="$(uci -q get "tailscale.service.$port_option")"
target_port="$(uci -q get tailscale.service.funnel_target_port)"
target_ip="$(uci -q get tailscale.service.funnel_target_ip)"
[ -n "$target_ip" ] || target_ip=127.0.0.1
if [ "$mode" = tls-terminated-tcp ]; then
	target_ip="$(uci -q get tailscale.service.funnel_ssh_target_ip)"
	target_port="$(uci -q get tailscale.service.funnel_ssh_target_port)"
	[ -n "$target_ip" ] || target_ip=127.0.0.1
	[ -n "$target_port" ] || target_port=22
	if [ "$target_ip" = 127.0.0.1 ] && { [ "$target_port" = 22 ] || [ "$target_port" = 2222 ]; } &&
		[ "$(uci -q get tailscale.service.funnel_ssh_password_auth)" != 1 ]; then
		{ [ -s /etc/dropbear/authorized_keys ] || [ -s /root/.ssh/authorized_keys ]; } || {
			set_status error "Install an SSH public key before enabling SSH Funnel"; exit 1;
		}
	fi
fi
case "$port" in 443 | 8443 | 10000) ;; *) set_status error "Invalid Funnel HTTPS port"; exit 1 ;; esac
valid_funnel_target "$target_ip" "$target_port" || {
	set_status error "Invalid Funnel destination IP or port"; exit 1;
}
# The HTTP reverse proxy accepts loopback only. TLS-terminated forwarding
# also supports HTTP services on other destination addresses.
[ "$target_ip" = 127.0.0.1 ] || mode=tls-terminated-tcp
target_host="$target_ip"
case "$target_host" in *:*) target_host="[$target_host]" ;; esac
target="http://$target_host:$target_port"
[ "$mode" != tls-terminated-tcp ] || target="tcp://$target_host:$target_port"

set_status waiting "Waiting for Tailscale connection"
attempt=0
while [ "$attempt" -lt 300 ]; do
	[ "$(uci -q get tailscale.service.enabled)" = 1 ] || exit 0
	[ "$(uci -q get tailscale.service.connect)" = 1 ] || exit 0
	if [ -S /var/run/tailscale/tailscaled.sock ] &&
		ip -4 addr show dev tailscale0 2>/dev/null | grep -q 'inet '; then
		break
	fi
	attempt=$((attempt + 1))
	sleep 2
done
[ "$attempt" -lt 300 ] || { set_status error "Timed out waiting for Tailscale connection"; exit 1; }

if [ -r "$owned_port_file" ] && { [ "$(cat "$owned_port_file")" != "$port" ] ||
  { [ -r "$owned_port_file.mode" ] && [ "$(cat "$owned_port_file.mode")" != "$mode" ]; } ||
  { [ ! -r "$owned_port_file.mode" ] && [ "$legacy_mode" != "$mode" ]; }; }; then
	stop_owned || { set_status error "Cannot disable previous Funnel port"; exit 1; }
fi
mkdir -p "$state_dir" || exit 1
# Also track partially applied commands so disabling the switch can clean up.
printf '%s\n' "$port" > "$owned_port_file" || exit 1
printf '%s\n' "$mode" > "$owned_port_file.mode" || exit 1
set_status configuring "Configuring Funnel"
attempt=0
while [ "$attempt" -lt 20 ]; do
	timeout 20 /usr/sbin/tailscale funnel --bg --yes "--$mode=$port" "$target" > "$output_file" 2>&1
	result=$?
	approval_url="$(grep -Eo 'https://login\.tailscale\.com/[a-zA-Z0-9/?=&_%.-]+' "$output_file" | head -n 1)"
	public_url="$(grep -Eo 'https://[a-zA-Z0-9.-]+\.ts\.net(:[0-9]+)?/?' "$output_file" | head -n 1)"
	if [ "$enabled_option" = funnel_ssh_enabled ]; then
		public_url="$(grep -Eo '[a-zA-Z0-9.-]+\.ts\.net' "$output_file" | head -n 1)"
		[ -z "$public_url" ] || public_url="$public_url:$port"
	elif [ "$mode" = tls-terminated-tcp ]; then
		public_url="$(grep -Eo '[a-zA-Z0-9.-]+\.ts\.net' "$output_file" | head -n 1)"
		if [ -n "$public_url" ]; then
			[ "$port" = 443 ] || public_url="$public_url:$port"
			public_url="https://$public_url/"
		fi
	fi
	if [ -n "$approval_url" ]; then
		set_status authorization_required "Enable Funnel in your tailnet"
		attempt=$((attempt + 1))
		[ "$attempt" -lt 20 ] || exit 0
		sleep 15
	elif [ "$result" = 0 ]; then
		set_status active "Funnel active"
		exit 0
	else
		detail="$(tail -c 600 "$output_file" | tr '\r\n' '  ')"
		set_status error "Funnel configuration failed: $detail"
		exit 1
	fi
done

}

case "$1" in
	validate-target) valid_funnel_target "$2" "$3"; exit $? ;;
	funnel) run_funnel; exit $? ;;
	funnel-stop) run_funnel stop; exit $? ;;
	funnel-ssh) run_funnel ssh; exit $? ;;
	funnel-ssh-stop) run_funnel ssh-stop; exit $? ;;
esac

connect_status=/tmp/modgui-tailscale-connect-status
auth_file=/tmp/modgui-tailscale-auth

set_status() {
	printf 'state=%s\nmessage=%s\n' "$1" "$2" > "$connect_status"
}

set_status waiting "Waiting for Tailscale daemon"
attempt=0
while [ "$attempt" -lt 180 ]; do
	[ "$(uci -q get tailscale.service.enabled)" = 1 ] || exit 0
	# On some Technicolor ARMv7 builds the CLI prints a valid status response
	# but exits non-zero afterwards. The daemon socket is the reliable readiness
	# signal and avoids holding authorization behind that firmware quirk.
	if [ -x /usr/sbin/tailscale ] && [ -S /var/run/tailscale/tailscaled.sock ]; then
		break
	fi
	attempt=$((attempt + 1))
	sleep 1
done

if [ "$attempt" -ge 180 ]; then
	set_status error "Timed out waiting for Tailscale daemon"
	exit 1
fi

if [ "$(uci -q get tailscale.service.connect)" != 1 ]; then
	/usr/sbin/tailscale down >/dev/null 2>&1
	rm -f "$auth_file"
	set_status stopped "Connection disabled"
	exit 0
fi

hostname="$(uci -q get tailscale.service.hostname)"
advertise_routes="$(uci -q get tailscale.service.advertise_routes)"
advertise_exit_node="$(uci -q get tailscale.service.advertise_exit_node)"
accept_routes="$(uci -q get tailscale.service.accept_routes)"
ssh_enabled="$(uci -q get tailscale.service.ssh)"
accept_dns="$(uci -q get tailscale.service.accept_dns)"
[ "$accept_dns" = 1 ] || accept_dns=0

set -- up --reset "--hostname=$hostname" "--accept-routes=$accept_routes" "--accept-dns=$accept_dns" \
	"--advertise-exit-node=$advertise_exit_node" "--ssh=$ssh_enabled" \
	--netfilter-mode=off --timeout=10s
[ -n "$advertise_routes" ] && set -- "$@" "--advertise-routes=$advertise_routes"

set_status connecting "Connecting to Tailscale"
umask 077
if /usr/sbin/tailscale "$@" > "$auth_file" 2>&1; then
	rm -f "$auth_file"
	set_status connected "Connected"
	exit 0
fi
# Under severe memory pressure the ARMv7 CLI can time out before echoing the
# URL even though tailscaled has already logged the successful AuthURL reply.
# Recover only the canonical HTTPS URL emitted by the local daemon.
if ! grep -q 'https://login.tailscale.com/' "$auth_file"; then
	auth_url="$(logread | sed -n 's|.*AuthURL is \(https://login\.tailscale\.com/[^[:space:]]*\).*|\1|p' | tail -n 1)"
	if [ -n "$auth_url" ]; then
		printf '\nTo authenticate, visit:\n\n\t%s\n' "$auth_url" >> "$auth_file"
	fi
fi
chown root:nogroup "$auth_file" 2>/dev/null || true
chmod 640 "$auth_file"
if grep -q 'https://login.tailscale.com/' "$auth_file"; then
	set_status authorization_required "Authorization required"
	# The control connection remains active while the user opens the URL.
	# Detect authorization through the lightweight interface address instead
	# of repeatedly launching the memory-hungry Go CLI on 512 MB gateways.
	attempt=0
	while [ "$attempt" -lt 300 ]; do
		[ "$(uci -q get tailscale.service.enabled)" = 1 ] || exit 0
		[ "$(uci -q get tailscale.service.connect)" = 1 ] || exit 0
		if ip -4 addr show dev tailscale0 2>/dev/null | grep -q 'inet '; then
			rm -f "$auth_file"
			set_status connected "Connected"
			exit 0
		fi
		attempt=$((attempt + 1))
		sleep 2
	done
	exit 0
fi
set_status error "Tailscale connection failed"
cat "$auth_file" >&2
exit 1
