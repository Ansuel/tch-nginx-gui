#!/bin/sh /etc/rc.common
#set -x
START=20

kernel_ver="$(cat /proc/version | awk '{print $3}')"

uci2onoff() {
    case "$1" in
        0) echo "off";;
        1) echo "on";;
        *) echo "Invalid UCI enable option: $1" 1>&2; echo "on";;
    esac
}

read_power_options() {
    # The show section repeats option names without their config arguments.
    pwrctl "$@" 2>&1 | awk '
        $1 == "pwrctl" && $2 == "show" { exit }
        $1 ~ /^--/ { print $1, $2 }
    '
}

setup_switch() {
    local section="$1" setting="$2" option switch_value
    shift 2
    for option in "$@"; do
        if printf '%s\n' "$power_options" | grep -q "^$option "; then
            config_get switch_value "$section" "$setting" 1
            pwrctl config "$option" "$(uci2onoff "$switch_value")"
            return $?
        fi
    done
}

setup_cpuspeed() {
    local cpuspeed
    config_get cpuspeed cpu cpuspeed
    [ -n "$cpuspeed" ] || return 0

    if printf '%s\n' "$power_options" | grep -qxF -- '--cpuspeed on|off'; then
        # Zero is the GUI's full-speed sync mode. Preserve it as a speed.
        case "$cpuspeed" in
            on|off) pwrctl config --cpuspeed "$cpuspeed" ;;
            *) pwrctl config --cpuspeed on "$cpuspeed" ;;
        esac
    elif printf '%s\n' "$power_options" | grep -q '^--cpuspeed '; then
        pwrctl config --cpuspeed "$cpuspeed"
    fi
}

move_irq_interrupts_cpu1() {
	#This cause crash on kernel 4.1 so only apply to kernel 3.4
	if [ -z "${kernel_ver##3.4*}" ]; then
		echo 2 > /proc/irq/72/smp_affinity
		echo 2 > /proc/irq/92/smp_affinity
		echo 2 > /proc/irq/98/smp_affinity
	fi
}

setup() {
    local power_options

    if command -v pwrctl >/dev/null 2>&1; then
        power_options="$(read_power_options help)"
        [ -n "$power_options" ] || power_options="$(read_power_options --help)"
        # Preserve the original commands on firmware with no usable help.
        [ -n "$power_options" ] || power_options='--autogreeen on|off
--eee on|off
--ethapd on|off
--wait on|off
--cpuspeed [speed]'
        config_load power
        setup_switch ethernet autogreeen --autogreeen
        setup_switch ethernet eee --eee
        setup_switch ethernet ethapd --ethapd --apd
        setup_switch cpu wait --wait --cpuwait
        setup_cpuspeed
    fi
    move_irq_interrupts_cpu1
}

start() {
    setup
}

reload() {
    setup
}

