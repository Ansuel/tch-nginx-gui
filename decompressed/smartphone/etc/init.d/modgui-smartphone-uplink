#!/bin/sh /etc/rc.common
START=95
STOP=10
USE_PROCD=1

start_service() {
    [ "$(uci -q get smartphone.uplink.enabled)" = 1 ] || return 0
    mkdir -p /var/run/modgui-smartphone-uplink
    chmod 700 /var/run/modgui-smartphone-uplink
    rm -f /var/run/modgui-smartphone-uplink/stop
    procd_open_instance
    procd_set_param command "$(command -v lua)" /usr/share/modgui-smartphone/uplink.lua daemon
    procd_set_param respawn 3600 5 3
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_set_param term_timeout 12
    procd_close_instance
}

stop_service() {
    lua /usr/share/modgui-smartphone/uplink.lua cleanup
}
