#!/bin/sh /etc/rc.common
START=95
STOP=10
USE_PROCD=1
EXTRA_COMMANDS="stop_uplink"

prepare_dns() {
    [ "$(uci -q get smartphone.uplink.enabled)" = 1 ] || return 0
    [ "$(uci -q get smartphone.uplink.dns_managed)" = 1 ] || return 0
    mkdir -p /var/run/modgui-smartphone-dns || return 1
    chmod 755 /var/run/modgui-smartphone-dns || return 1
    touch /var/run/modgui-smartphone-dns/resolv.conf || return 1
    chmod 644 /var/run/modgui-smartphone-dns/resolv.conf
}

# One init script, two boot phases: prepare volatile DNS before dnsmasq (S19),
# then start the network monitor at S95 after the other networking services.
boot() {
    case "$initscript" in
        */S18modgui-smartphone-uplink) prepare_dns ;;
        *) start "$@" ;;
    esac
}

enable() {
    disable
    ln -sf ../init.d/modgui-smartphone-uplink "${IPKG_INSTROOT}/etc/rc.d/S18modgui-smartphone-uplink" &&
    ln -sf ../init.d/modgui-smartphone-uplink "${IPKG_INSTROOT}/etc/rc.d/S${START}modgui-smartphone-uplink" &&
    ln -sf ../init.d/modgui-smartphone-uplink "${IPKG_INSTROOT}/etc/rc.d/K${STOP}modgui-smartphone-uplink"
}

disable() {
    rm -f "${IPKG_INSTROOT}"/etc/rc.d/S??modgui-smartphone-uplink \
          "${IPKG_INSTROOT}"/etc/rc.d/K??modgui-smartphone-uplink
}

start_service() {
    [ -x /usr/bin/phone_stats.sh ] || return 0
    procd_open_instance adb
    procd_set_param command /usr/bin/phone_stats.sh watch_adb
    procd_set_param respawn 3600 5 3
    procd_set_param term_timeout 8
    procd_close_instance
    [ "$(uci -q get smartphone.uplink.enabled)" = 1 ] || return 0
    prepare_dns || return 1
    mkdir -p /var/run/modgui-smartphone-uplink
    chmod 700 /var/run/modgui-smartphone-uplink
    rm -f /var/run/modgui-smartphone-uplink/stop
    procd_open_instance uplink
    procd_set_param command "$(command -v lua)" /usr/share/modgui-smartphone/uplink.lua daemon
    procd_set_param respawn 3600 5 3
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_set_param term_timeout 12
    procd_close_instance
}

stop_uplink() {
    procd_kill modgui-smartphone-uplink uplink
}

stop_service() {
    lua /usr/share/modgui-smartphone/uplink.lua cleanup
}
